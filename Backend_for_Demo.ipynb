    "import sys\n",
    "\n",
    "def print_progress(i, total, stage, info=None):\n",
    "    print(f\"[{i+1}/{total}] Stage: {stage}\")\n",
    "    if info:\n",
    "        print(f\"   Info: {info[:100]}\")  # truncate for readability\n",
    "\n",
    "def print_progress_status_bar(i, total, stage, info=None, bar_len=40):\n",
    "    completed = i + 1\n",
    "    progress = (completed / total)\n",
    "    bar = '#' * int(bar_len * progress) + '-' * (bar_len - int(bar_len * progress))\n",
    "    sys.stdout.write(f'\\r[{completed}/{total}] [{bar}] {progress:.1%} Stage: {stage}')\n",
    "    sys.stdout.flush()\n",
    "    if completed == total:\n",
    "        sys.stdout.write('\\n') # Newline at the end for final completion message\n",
    "\n",
    "cascade_results = []     # Cascade results\n",
    "entropy_results = []    # Entropy results\n",
    "start_idx = 0  # or your checkpoint index\n"
   ]
