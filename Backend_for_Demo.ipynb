    "print(f\"Detection Accuracy         : {cascade_metrics.get('detection_accuracy', np.nan):.4f}\")\n",
    "\n",
    "print(\"\\nSemantic Entropy\")\n",
    "print(f\"AUROC                      : {entropy_metrics['auroc']:.4f}\")\n",
    "print(f\"Optimal Threshold          : {entropy_metrics.get('optimal_threshold', np.nan):.4f}\")\n",
    "print(f\"Detection Accuracy         : {entropy_metrics.get('detection_accuracy', np.nan):.4f}\")\n",
    "\n",
    "print(\"\\nNOTE:\")\n",
    "print(\"Both MSCF and Semantic Entropy are evaluated against the SAME\")\n",
    "print(\"SBERT semantic-similarity majority-vote ground truth, making\")\n",
    "print(\"their AUROC values directly comparable.\")"
