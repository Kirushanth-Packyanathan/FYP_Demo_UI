    "#  METRICS \u2014 AUROC, AURAC, Brier, Latency\n",
    "from sklearn.metrics import roc_auc_score, brier_score_loss\n",
    "import numpy as np\n",
    "\n",
    "def compute_auroc(y_true, y_scores):\n",
    "    \"\"\"\n",
    "    AUROC following Kuhn et al. (2023) Semantic Uncertainty paper.\n",
    "\n",
    "    Convention (matching paper exactly):\n",
    "      correctness_labels : 1 = wrong/hallucination, 0 = correct\n",
    "      uncertainty_scores : semantic entropy (higher = more uncertain)\n",
    "\n",
    "    sklearn.metrics.roc_auc_score(correctness_labels, uncertainty_scores)\n",
    "    gives P(entropy_wrong > entropy_correct) \u2014 identical to paper evaluation.\n",
    "    \"\"\"\n",
    "    correctness_labels = y_true    # 1 = wrong, 0 = correct  (Kuhn et al.)\n",
    "    uncertainty_scores = y_scores  # semantic entropy values\n",
    "    if len(set(correctness_labels)) < 2:\n",
    "        return 0.5\n",
    "    return float(roc_auc_score(correctness_labels, uncertainty_scores))\n",
    "\n",
    "def compute_aurac(y_true, y_scores, num_t=100):\n",
    "    y_t = np.array(y_true)\n",
    "    y_s = np.array(y_scores)\n",
    "    order = np.argsort(y_s)\n",
    "    y_sorted = y_t[order]\n",
    "    n = len(y_sorted)\n",
    "    covs = np.linspace(0.01, 1.0, num_t)\n",
    "    risks = [float(y_sorted[:max(1, int(c * n))].mean()) for c in covs]\n",
    "    _trapz = getattr(np, 'trapezoid', getattr(np, 'trapz', None))\n",
    "    return float(_trapz(risks, covs))\n",
    "\n",
    "def evaluate_all(y_true, y_scores, latencies):\n",
    "    if not y_true:\n",
    "        return {\n",
    "            'auroc': 0, 'aurac': 0, 'brier_score': 0,\n",
    "            'latency': {'mean': 0, 'total': 0},\n",
    "            'num_samples': 0, 'hallucination_rate': 0\n",
    "        }\n",
    "    arr = np.array(latencies)\n",
    "    return {\n",
    "        'auroc': compute_auroc(y_true, y_scores),\n",
    "        'aurac': compute_aurac(y_true, y_scores),\n",
    "        'brier_score': float(brier_score_loss(y_true, np.clip(y_scores, 0, 1))),\n",
    "        'latency': {\n",
    "            'mean': float(arr.mean()),\n",
    "            'median': float(np.median(arr)),\n",
    "            'p95': float(np.percentile(arr, 95)),\n",
    "            'total': float(arr.sum())\n",
    "        },\n",
    "        'num_samples': len(y_true),\n",
    "        'hallucination_rate': float(np.mean(y_true))\n",
    "    }\n",
    "\n",
    "print('Metrics ready')"
   ]
