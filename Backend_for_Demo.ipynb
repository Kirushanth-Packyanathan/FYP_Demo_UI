   "source": [
    "#  CLUSTERING \u2014 Agglomerative with bi-encoder embeddings\n",
    "from sentence_transformers import SentenceTransformer\n",
    "from sklearn.cluster import AgglomerativeClustering\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "import torch\n",
    "\n",
    "# Load to GPU if available\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "_encoder = SentenceTransformer(BI_ENCODER_MODEL, device=device)\n",
    "\n",
    "def embed_responses(responses):\n",
    "    return np.array(_encoder.encode(responses, normalize_embeddings=True))\n",
    "\n",
    "def cluster_responses(responses, similarity_threshold=None):\n",
    "    threshold = CLUSTER_SIM_THRESH\n",
    "\n",
    "    # Converts all responses into vectors\n",
    "    embeddings = embed_responses(responses)\n",
    "\n",
    "    # if only one response\n",
    "    if len(responses) == 1:\n",
    "        return {'clusters':[0],'num_clusters':1,'cluster_sizes':{0:1},\n",
    "                'embeddings':embeddings,'sim_matrix':np.array([[1.0]]),'cluster_map':{0:[responses[0]]}}\n",
    "\n",
    "    # calculate similarity matrix using cosine similarity\n",
    "    sim_matrix = cosine_similarity(embeddings)\n",
    "\n",
    "    # transforms a similarity matrix into a distance matrix\n",
    "    ''''\n",
    "    higher similarity - small distance\n",
    "    low similarity - large distance\n",
    "    '''\n",
    "    dist = np.clip(1.0 - sim_matrix, 0, None); np.fill_diagonal(dist, 0)\n",
    "\n",
    "\n",
    "    labels = AgglomerativeClustering(n_clusters=None, distance_threshold=1.0-threshold,\n",
    "                                     metric='precomputed', linkage='average').fit_predict(dist)\n",
    "\n",
    "    # empty dictionary initialization\n",
    "    cluster_map, cluster_sizes = {}, {}\n",
    "\n",
    "    # iterate through each labeled samples\n",
    "    for i, lb in enumerate(labels):\n",
    "\n",
    "        # ensure label is integer\n",
    "        lb = int(lb)\n",
    "\n",
    "        # if lb exist retuen existing list else create new empty list\n",
    "        # append current data point to the list(cluster)\n",
    "        cluster_map.setdefault(lb, []).append(i)\n",
    "\n",
    "        # count clister size\n",
    "        # if cluster exist increment 1 else initialize with 1\n",
    "        cluster_sizes[lb] = cluster_sizes.get(lb, 0) + 1\n",
    "\n",
    "    return {'clusters':[int(l) for l in labels],'num_clusters':len(cluster_sizes),\n",
    "            'cluster_sizes':cluster_sizes,'embeddings':embeddings,\n",
    "            'sim_matrix':sim_matrix.tolist(),'cluster_map':cluster_map}\n",
    "\n",
    "def compute_dispersion(embeddings):\n",
    "\n",
    "    # only one response\n",
    "    if len(embeddings) < 2: return 0.0\n",
    "\n",
    "    sim = cosine_similarity(embeddings)\n",
    "\n",
    "    # extract unique pairwise similarities(extracts only upper triangle (excluding diagonal))\n",
    "    n = len(sim)\n",
    "    upper = sim[np.triu_indices(n, k=1)]\n",
    "\n",
    "    return 1.0 - float(np.mean(upper))\n",
    "\n",
    "print(f'Clustering ready (Encoder on {device})')"
   ]
