    "#  SEMANTIC ENTROPY + NLI CLUSTERING (Paper Approach)\n",
    "import math\n",
    "import numpy as np\n",
    "import torch\n",
    "from transformers import AutoTokenizer, AutoModelForSequenceClassification\n",
    "\n",
    "# Global cache for NLI model\n",
    "_nli_tok = None\n",
    "_nli_model = None\n",
    "\n",
    "def _load_nli():\n",
    "    # Singleton Pattern - Only one instance of tokenizer/model exists globally\n",
    "    global _nli_tok, _nli_model\n",
    "    if _nli_tok is None:\n",
    "        _nli_tok = AutoTokenizer.from_pretrained(NLI_MODEL_NAME)\n",
    "        _nli_model = AutoModelForSequenceClassification.from_pretrained(NLI_MODEL_NAME)\n",
    "        _nli_model.eval()\n",
    "        if torch.cuda.is_available():\n",
    "            _nli_model = _nli_model.cuda()\n",
    "    return _nli_tok, _nli_model\n",
    "\n",
    "_nli_tok, _nli_model = _load_nli()\n",
    "\n",
    "# LENGTH-NORMALIZED LOG-PROBABILITIES\n",
    "def compute_length_normalized_logprobs(samples):\n",
    "    \"\"\"\n",
    "    Compute length-normalized log-prob per sample.\n",
    "    Returns list of floats (log-probabilities, NOT probabilities).\n",
    "    \"\"\"\n",
    "    log_liks_agg = []\n",
    "    for s in samples:\n",
    "        logprobs = s.get('logprobs', [])\n",
    "        if not logprobs or len(logprobs) == 0:\n",
    "            log_liks_agg.append(0.0)  # log(1) = 0 => uniform fallback\n",
    "        else:\n",
    "            log_liks_agg.append(float(np.mean(logprobs)))  # length-normalized\n",
    "    return log_liks_agg\n",
    "\n",
    "\n",
    "# NLI CHECK \u2014 returns class label (0=contradiction, 1=neutral, 2=entailment)\n",
    "def _check_implication(text1, text2):\n",
    "    \"\"\"Check if text1 entails text2. Returns 0/1/2.\"\"\"\n",
    "    tokenizer = _nli_tok\n",
    "    model = _nli_model\n",
    "    device = next(model.parameters()).device\n",
    "\n",
    "    inp = tokenizer(text1, text2, return_tensors='pt',\n",
    "                    truncation=True, max_length=512, padding=True)\n",
    "    inp = {k: v.to(device) for k, v in inp.items()}\n",
    "\n",
    "    \"\"\"\n",
    "    disables gradient tracking,\n",
    "    During training, PyTorch tracks operations to compute gradients using autograd\n",
    "    During inference, gradients are not needed\n",
    "    \"\"\"\n",
    "    with torch.no_grad():\n",
    "        logits = model(**inp).logits\n",
    "        # DeBERTa-MNLI: [contradiction=0, neutral=1, entailment=2]\n",
    "        prediction = torch.argmax(torch.softmax(logits, dim=-1), dim=-1).cpu().item()\n",
    "\n",
    "    return prediction\n",
    "\n",
    "\n",
    "# GREEDY SEQUENTIAL CLUSTERING (matches reference get_semantic_ids)\n",
    "def cluster_responses_nli(responses, question=None, strict_entailment=True):\n",
    "    \"\"\"\n",
    "    Cluster responses by semantic equivalence using bidirectional NLI.\n",
    "    \"\"\"\n",
    "    n = len(responses)\n",
    "    if n == 0:\n",
    "        return []\n",
    "    if n == 1:\n",
    "        return [0]\n",
    "\n",
    "    def are_equivalent(text1, text2):\n",
    "        # Prepend question for context (as in reference when condition_on_question=True)\n",
    "        if question:\n",
    "            t1 = f\"{question} {text1}\"\n",
    "            t2 = f\"{question} {text2}\"\n",
    "        else:\n",
    "            t1 = text1\n",
    "            t2 = text2\n",
    "\n",
    "        imp_1 = _check_implication(t1, t2)  # text1 -> text2\n",
    "        imp_2 = _check_implication(t2, t1)  # text2 -> text1\n",
    "\n",
    "        if strict_entailment:\n",
    "            # Both must be entailment (label 2)\n",
    "            return (imp_1 == 2) and (imp_2 == 2)\n",
    "        else:\n",
    "            # Reference non-strict: no contradiction AND not both neutral\n",
    "            implications = [imp_1, imp_2]\n",
    "            return (0 not in implications) and (implications != [1, 1])\n",
    "\n",
    "    # Greedy sequential assignment (matches reference exactly)\n",
    "    # create list of size n, each value -1 means not yet assigned to any cluster\n",
    "    semantic_ids = [-1] * n\n",
    "\n",
    "    # Initializes the first cluster label.\n",
    "    next_id = 0\n",
    "\n",
    "    for i in range(n):\n",
    "        if semantic_ids[i] == -1:\n",
    "            semantic_ids[i] = next_id\n",
    "            for j in range(i + 1, n):\n",
    "                if semantic_ids[j] == -1:  # not yet assigned\n",
    "                    if are_equivalent(responses[i], responses[j]):\n",
    "                        semantic_ids[j] = next_id\n",
    "\n",
    "            # move to next cluster\n",
    "            next_id += 1\n",
    "\n",
    "    assert -1 not in semantic_ids\n",
    "    return semantic_ids\n",
    "\n",
    "\n",
    "# LOGSUMEXP BY SEMANTIC ID (matches reference logsumexp_by_id)\n",
    "def logsumexp_by_id(semantic_ids, log_likelihoods):\n",
    "    \"\"\"\n",
    "    Sum probabilities with the same semantic id, in log space.\n",
    "\n",
    "    Uses 'sum_normalized' aggregation:\n",
    "      log_lik_norm = id_log_liks - log(sum(exp(all_log_liks)))\n",
    "      cluster_log_prob = log(sum(exp(log_lik_norm)))\n",
    "    \"\"\"\n",
    "    unique_ids = sorted(set(semantic_ids))\n",
    "    log_likelihoods = np.array(log_likelihoods, dtype=np.float64)\n",
    "    log_likelihood_per_semantic_id = []\n",
    "\n",
    "    for uid in unique_ids:\n",
    "        id_indices = [pos for pos, x in enumerate(semantic_ids) if x == uid]\n",
    "        id_log_likelihoods = log_likelihoods[id_indices]\n",
    "\n",
    "        # sum_normalized: normalize by total probability mass first\n",
    "        log_normalizer = np.log(np.sum(np.exp(log_likelihoods)))\n",
    "        log_lik_norm = id_log_likelihoods - log_normalizer\n",
    "        logsumexp_value = np.log(np.sum(np.exp(log_lik_norm)))\n",
    "\n",
    "        log_likelihood_per_semantic_id.append(logsumexp_value)\n",
    "\n",
    "    return log_likelihood_per_semantic_id\n",
    "\n",
    "\n",
    "# SEMANTIC ENTROPY (matches reference predictive_entropy_rao)\n",
    "def compute_semantic_entropy_nli(semantic_ids, log_liks_agg):\n",
    "    \"\"\"\n",
    "    Compute semantic entropy over meaning clusters.\n",
    "    NO normalization by log(N) \u2014 raw entropy is used for AUROC ranking.\n",
    "    \"\"\"\n",
    "    # Aggregate log-probs per semantic cluster\n",
    "    log_probs_per_cluster = logsumexp_by_id(semantic_ids, log_liks_agg)\n",
    "    log_probs_per_cluster = np.array(log_probs_per_cluster)\n",
    "\n",
    "    # Predictive entropy (Rao) \u2014 reference formula\n",
    "    entropy = float(-np.sum(np.exp(log_probs_per_cluster) * log_probs_per_cluster))\n",
    "\n",
    "    return entropy\n",
    "\n",
    "\n",
    "# MAIN DETECTION FUNCTION\n",
    "async def detect_hallucination_semantic_entropy(prompt, question=None, m=10, samples=None):\n",
    "    \"\"\"\n",
    "    Detects hallucination using semantic entropy and question-aware NLI.\n",
    "\n",
    "    Follows the reference pipeline:\n",
    "    1. Length-normalize log-probs -> log_liks_agg\n",
    "    2. Greedy NLI clustering -> semantic_ids\n",
    "    3. logsumexp_by_id -> percluster log-probs\n",
    "    4. predictive_entropy_rao -> semantic entropy (no normalization)\n",
    "    \"\"\"\n",
    "    if samples is None:\n",
    "        samples = await sample_responses(prompt=prompt, num_samples=m, temperature=1.0)\n",
    "\n",
    "    responses = [s['response'] for s in samples]\n",
    "\n",
    "    # Step 1: Compute length-normalized log-probabilities\n",
    "    log_liks_agg = compute_length_normalized_logprobs(samples)\n",
    "\n",
    "    # Step 2: Cluster by bidirectional NLI entailment (greedy assignment)\n",
    "    semantic_ids = cluster_responses_nli(responses, question=question)\n",
    "\n",
    "    # Step 3+4: Compute semantic entropy (logsumexp + Rao entropy)\n",
    "    semantic_entropy = compute_semantic_entropy_nli(semantic_ids, log_liks_agg)\n",
    "\n",
    "    # Build cluster map for display\n",
    "    cluster_map = {}\n",
    "    for i, sid in enumerate(semantic_ids):\n",
    "        cluster_map.setdefault(sid, []).append(responses[i])\n",
    "\n",
    "    return {\n",
    "        'query': question if question else prompt,   # Kuhn et al.: track per-question\n",
    "        'responses': responses,\n",
    "        'clusters': list(cluster_map.values()),\n",
    "        'semantic_entropy': semantic_entropy,\n",
    "        'semantic_ids': semantic_ids,\n",
    "        'log_liks_agg': log_liks_agg,\n",
    "        'num_clusters': len(set(semantic_ids))\n",
    "    }\n",
    "\n",
    "print('Semantic Entropy pipeline (paper-accurate, reference-matched) is ready!')"
   ]
  },
