    "#  ENTROPY \u2014 Weighted semantic entropy\n",
    "\n",
    "def compute_weighted_semantic_entropy(cluster_map, samples, normalize=True):\n",
    "    n = len(samples)\n",
    "    if n <= 1: return 0.0\n",
    "\n",
    "    # Step 1 \u2014 Length-normalized log-probs \u2192 probabilities\n",
    "    p_raw = []\n",
    "    for s in samples:\n",
    "        logprobs = s.get('logprobs', [])\n",
    "        if logprobs and len(logprobs) > 0:\n",
    "            avg_logprob = sum(logprobs) / len(logprobs)  # length-normalized\n",
    "            p_raw.append(math.exp(avg_logprob))\n",
    "        else:\n",
    "            p_raw.append(1.0)\n",
    "\n",
    "    # Step 2 \u2014 Normalize raw probs to sum to 1\n",
    "    total = sum(p_raw)\n",
    "    if total > 0:\n",
    "        p_norm = [p / total for p in p_raw]\n",
    "    else:\n",
    "        p_norm = [1/n] * n\n",
    "\n",
    "    # Step 3 \u2014 Compute cluster probabilities\n",
    "    cluster_probs = []\n",
    "    for cid, indices in cluster_map.items():\n",
    "        p_ck = sum(p_norm[i] for i in indices)\n",
    "        cluster_probs.append(p_ck)\n",
    "\n",
    "    # Step 4 \u2014 Entropy (no normalization by default to match reference)\n",
    "    h = -sum(p * math.log(p) for p in cluster_probs if p > 0)\n",
    "\n",
    "    # Step 5 \u2014 Optional normalization (kept for CASCADE gating compatibility)\n",
    "    if normalize and n > 1:\n",
    "        max_h = math.log(n)\n",
    "        return h / max_h if max_h > 0 else 0.0\n",
    "\n",
    "    return h\n",
    "\n",
    "\n",
    "\n",
    "#  LOGIT CONFIDENCE\n",
    "\n",
    "def normalised_confidence(logprobs):\n",
    "    if not logprobs:\n",
    "      return 0.5\n",
    "    return math.exp(sum(logprobs) / len(logprobs))\n",
    "\n",
    "def aggregate_confidence(samples):\n",
    "    confs = [normalised_confidence(s.get('logprobs',[])) for s in samples]\n",
    "    if not confs: return {'mean':0.5}\n",
    "    return {'mean':float(np.mean(confs)),'min':float(np.min(confs)),'max':float(np.max(confs))}\n",
    "\n",
    "print('Entropy + Confidence ready')"
   ]
