   "source": [
    "# Cell 2: Data Loading & Raw Feature Extraction\n",
    "if not os.path.exists(GEN_SAVE_PATH):\n",
    "    raise FileNotFoundError(\n",
    "        f\"No generated samples found at {GEN_SAVE_PATH}. \"\n",
    "        \"Please run the generation cell first.\"\n",
    "    )\n",
    "\n",
    "print(f\"Loading generated samples from {GEN_SAVE_PATH}...\")\n",
    "with open(GEN_SAVE_PATH, 'r') as f:\n",
    "    stored_data = json.load(f)\n",
    "print(f\"  Total items in file: {len(stored_data)}\")\n",
    "\n",
    "# Ground-truth reference\n",
    "loaders = {\n",
    "    'truthfulqa': load_truthfulqa,\n",
    "    'triviaqa':   load_triviaqa,\n",
    "    'squad':      load_squad,\n",
    "}\n",
    "full_dataset_ref = loaders.get(DATASET, load_triviaqa)(max_samples=MAX_QUESTIONS)\n",
    "q_to_answers = {\n",
    "    item['question']: item.get('correct_answers', [])\n",
    "    for item in full_dataset_ref\n",
    "}\n",
    "\n",
    "# Feature extraction loop\n",
    "train_records = []\n",
    "for idx, item in enumerate(stored_data[:TUNING_QUESTIONS]):\n",
    "    q       = item['question']\n",
    "    samples = item['responses']\n",
    "    ca      = q_to_answers.get(q, [])\n",
    "\n",
    "    texts = [s['response'] for s in samples if s['response']]\n",
    "    if not texts:\n",
    "        continue\n",
    "\n",
    "    ci   = cluster_responses(texts)\n",
    "    disp = compute_dispersion(ci['embeddings'])\n",
    "    sem_e = compute_weighted_semantic_entropy(ci['cluster_map'], samples)\n",
    "    conf  = aggregate_confidence(samples)['mean']\n",
    "\n",
    "    is_correct = semantic_correctness_check(texts, ca)\n",
    "    gt = 0 if is_correct else 1          # 1 = hallucination\n",
    "\n",
    "    train_records.append({\n",
    "        'H': sem_e,                       # Semantic entropy\n",
    "        'D': disp,                        # Dispersion\n",
    "        'C': conf,                        # Mean confidence\n",
    "        'K': float(ci['num_clusters']),   # Cluster count\n",
    "        'y': gt,                          # Ground truth label\n",
    "    })\n",
    "\n",
    "    if (idx + 1) % 50 == 0:\n",
    "        print(f\"  Processed {idx+1}/{TUNING_QUESTIONS} questions...\")\n",
    "\n",
    "print(f\"\\n Extracted {len(train_records)} usable records.\")"
   ]
