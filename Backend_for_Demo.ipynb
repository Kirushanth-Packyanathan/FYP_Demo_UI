    "import os\n",
    "import json\n",
    "import joblib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.neural_network import MLPClassifier\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "from sklearn.metrics import (\n",
    "    roc_auc_score,\n",
    "    roc_curve,\n",
    "    classification_report,\n",
    "    confusion_matrix,\n",
    ")\n",
    "from sklearn.inspection import permutation_importance\n",
    "from imblearn.over_sampling import SMOTE\n",
    "\n",
    "\n",
    "def train_and_save_fuser(\n",
    "    df_train,\n",
    "    feature_cols,\n",
    "    model_path,\n",
    "    scaler_path,\n",
    "    metrics_path,\n",
    "    n_splits=5,\n",
    "    random_state=42,\n",
    "):\n",
    "    \"\"\"\n",
    "    Train the MLP uncertainty fuser.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    model\n",
    "    scaler\n",
    "    training_auroc\n",
    "    cv_auroc\n",
    "    \"\"\"\n",
    "\n",
    "\n",
    "    # Prepare data\n",
    "    X = df_train[feature_cols].values\n",
    "    y = df_train[\"label\"].values\n",
    "\n",
    "    scaler = StandardScaler()\n",
    "    X_scaled = scaler.fit_transform(X)\n",
    "\n",
    "\n",
    "    # Handle single-class dataset\n",
    "    if len(np.unique(y)) < 2:\n",
    "        from sklearn.dummy import DummyClassifier\n",
    "\n",
    "        print(\"Insufficient class variance - creating fallback dummy model.\")\n",
    "\n",
    "        model = DummyClassifier(strategy=\"most_frequent\")\n",
    "        model.fit(X_scaled, y)\n",
    "\n",
    "        train_auroc = 0.5\n",
    "        test_auroc = 0.5\n",
    "\n",
    "    else:\n",
    "\n",
    "        # Random Oversampling\n",
    "        # print(\"Applying Random Oversampling...\")\n",
    "\n",
    "        # classes, counts = np.unique(y, return_counts=True)\n",
    "        # max_count = np.max(counts)\n",
    "\n",
    "        # np.random.seed(random_state)\n",
    "\n",
    "        # X_resampled = []\n",
    "        # y_resampled = []\n",
    "\n",
    "        # for cls in classes:\n",
    "\n",
    "        #     idx = np.where(y == cls)[0]\n",
    "\n",
    "        #     if len(idx) < max_count:\n",
    "        #         sampled_idx = np.random.choice(\n",
    "        #             idx,\n",
    "        #             size=max_count,\n",
    "        #             replace=True,\n",
    "        #         )\n",
    "        #     else:\n",
    "        #         sampled_idx = idx\n",
    "\n",
    "        #     X_resampled.append(X_scaled[sampled_idx])\n",
    "        #     y_resampled.append(y[sampled_idx])\n",
    "\n",
    "        # X_resampled = np.vstack(X_resampled)\n",
    "        # y_resampled = np.concatenate(y_resampled)\n",
    "\n",
    "        # shuffle = np.random.permutation(len(y_resampled))\n",
    "        # X_resampled = X_resampled[shuffle]\n",
    "        # y_resampled = y_resampled[shuffle]\n",
    "\n",
    "        print(\"Applying SMOTE...\")\n",
    "\n",
    "        smote = SMOTE(\n",
    "            random_state=random_state,\n",
    "            k_neighbors=5\n",
    "        )\n",
    "\n",
    "        X_resampled, y_resampled = smote.fit_resample(\n",
    "            X_scaled,\n",
    "            y\n",
    "        )\n",
    "\n",
    "        # Train MLP\n",
    "        model = MLPClassifier(\n",
    "            hidden_layer_sizes=(64, 32, 16),\n",
    "            activation=\"relu\",\n",
    "            solver=\"adam\",\n",
    "            alpha=0.001,\n",
    "            max_iter=4000,\n",
    "            random_state=random_state,\n",
    "            early_stopping=False,\n",
    "        )\n",
    "\n",
    "        model.fit(X_resampled, y_resampled)\n",
    "\n",
    "        # Training Metrics\n",
    "        y_prob = model.predict_proba(X_scaled)[:, 1]\n",
    "        y_pred = model.predict(X_scaled)\n",
    "\n",
    "        train_auroc = float(roc_auc_score(y, y_prob))\n",
    "\n",
    "        print(f\"Training AUROC : {train_auroc:.4f}\")\n",
    "\n",
    "        print(\"\\nClassification Report\")\n",
    "        print(\n",
    "            classification_report(\n",
    "                y,\n",
    "                y_pred,\n",
    "                target_names=[\"Correct\", \"Hallucination\"],\n",
    "            )\n",
    "        )\n",
    "\n",
    "        print(\"\\nConfusion Matrix\")\n",
    "\n",
    "        cm = confusion_matrix(y, y_pred)\n",
    "\n",
    "        sns.heatmap(\n",
    "            cm,\n",
    "            annot=True,\n",
    "            fmt=\"d\",\n",
    "            cmap=\"Blues\",\n",
    "            xticklabels=[\"Correct\", \"Hallucination\"],\n",
    "            yticklabels=[\"Correct\", \"Hallucination\"],\n",
    "        )\n",
    "\n",
    "        plt.xlabel(\"Predicted\")\n",
    "        plt.ylabel(\"Actual\")\n",
    "        plt.title(\"Confusion Matrix\")\n",
    "        plt.show()\n",
    "\n",
    "        # Stratified Cross Validation\n",
    "        print(\"\\nRunning 5-Fold Stratified CV...\")\n",
    "\n",
    "        skf = StratifiedKFold(\n",
    "            n_splits=n_splits,\n",
    "            shuffle=True,\n",
    "            random_state=random_state,\n",
    "        )\n",
    "\n",
    "        fold_scores = []\n",
    "\n",
    "        for train_idx, test_idx in skf.split(X_scaled, y):\n",
    "\n",
    "            X_train = X_scaled[train_idx]\n",
    "            y_train = y[train_idx]\n",
    "\n",
    "            X_test = X_scaled[test_idx]\n",
    "            y_test = y[test_idx]\n",
    "\n",
    "            # # Oversample training fold\n",
    "            # cls_train, cnt_train = np.unique(\n",
    "            #     y_train,\n",
    "            #     return_counts=True,\n",
    "            # )\n",
    "\n",
    "            # max_cnt = np.max(cnt_train)\n",
    "\n",
    "            # X_fold = []\n",
    "            # y_fold = []\n",
    "\n",
    "            # for cls in cls_train:\n",
    "\n",
    "            #     idx = np.where(y_train == cls)[0]\n",
    "\n",
    "            #     if len(idx) < max_cnt:\n",
    "            #         sampled = np.random.choice(\n",
    "            #             idx,\n",
    "            #             size=max_cnt,\n",
    "            #             replace=True,\n",
    "            #         )\n",
    "            #     else:\n",
    "            #         sampled = idx\n",
    "\n",
    "            #     X_fold.append(X_train[sampled])\n",
    "            #     y_fold.append(y_train[sampled])\n",
    "\n",
    "            # X_fold = np.vstack(X_fold)\n",
    "            # y_fold = np.concatenate(y_fold)\n",
    "\n",
    "            smote = SMOTE(\n",
    "                random_state=random_state,\n",
    "                k_neighbors=5\n",
    "            )\n",
    "\n",
    "            X_fold, y_fold = smote.fit_resample(\n",
    "                X_train,\n",
    "                y_train\n",
    "            )\n",
    "\n",
    "            fold_model = MLPClassifier(\n",
    "                hidden_layer_sizes=(64, 32, 16),\n",
    "                activation=\"relu\",\n",
    "                solver=\"adam\",\n",
    "                alpha=0.001,\n",
    "                max_iter=4000,\n",
    "                random_state=random_state,\n",
    "                early_stopping=False,\n",
    "            )\n",
    "\n",
    "            fold_model.fit(X_fold, y_fold)\n",
    "\n",
    "            probs = fold_model.predict_proba(X_test)[:, 1]\n",
    "\n",
    "            fold_scores.append(\n",
    "                roc_auc_score(y_test, probs)\n",
    "            )\n",
    "\n",
    "        fold_scores = np.array(fold_scores)\n",
    "\n",
    "        test_auroc = float(fold_scores.mean())\n",
    "\n",
    "        print(\n",
    "            f\"5-Fold CV AUROC : {test_auroc:.4f} \u00b1 {fold_scores.std():.4f}\"\n",
    "        )\n",
    "\n",
    "        print(\"Per Fold :\", np.round(fold_scores, 4))\n",
    "\n",
    "        # ROC Curve\n",
    "        fpr, tpr, _ = roc_curve(y, y_prob)\n",
    "\n",
