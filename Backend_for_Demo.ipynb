    "import re\n",
    "from datasets import load_dataset as hf_load_dataset\n",
    "\n",
    "def load_truthfulqa(max_samples=50):\n",
    "    ds = hf_load_dataset('truthfulqa/truthful_qa', 'generation', split='validation')\n",
    "    items = []\n",
    "    for row in ds:\n",
    "        items.append({'question':row['question'],'correct_answers':row.get('correct_answers',[]),\n",
    "                      'best_answer':row.get('best_answer',''),'source':'truthfulqa'})\n",
    "        if max_samples and len(items) >= max_samples: break\n",
    "    return items\n",
    "\n",
    "def load_triviaqa(max_samples=50):\n",
    "\n",
    "    # Fixed namespace issue\n",
    "    ds = hf_load_dataset(\n",
    "        \"mandarjoshi/trivia_qa\",\n",
    "        \"rc.nocontext\",\n",
    "        split=\"validation\"\n",
    "    )\n",
    "\n",
    "    items = []\n",
    "\n",
    "    for row in ds:\n",
    "\n",
    "        answer = row.get(\"answer\", {})\n",
    "\n",
    "        aliases = answer.get(\"aliases\", [])\n",
    "        value = answer.get(\"value\", \"\")\n",
    "\n",
    "        items.append({\n",
    "            \"question\": row[\"question\"],\n",
    "            \"correct_answers\": aliases if aliases else [value],\n",
    "            \"best_answer\": value,\n",
    "            \"source\": \"triviaqa\"\n",
    "        })\n",
    "\n",
    "        if max_samples and len(items) >= max_samples:\n",
    "            break\n",
    "\n",
    "    return items\n",
    "\n",
    "def load_squad(max_samples=50):\n",
    "    ds = hf_load_dataset('rajpurkar/squad', split='validation')\n",
    "    items = []\n",
    "    for row in ds:\n",
    "        ans_texts = row.get('answers', {}).get('text', [])\n",
    "        best_ans = ans_texts[0] if ans_texts else \"\"\n",
    "        items.append({'question':row['question'],'correct_answers':ans_texts,\n",
    "                      'best_answer':best_ans,'source':'squad'})\n",
    "        if max_samples and len(items) >= max_samples: break\n",
    "    return items\n",
    "\n",
    "def load_bioasq(max_samples=50):\n",
    "    ds = hf_load_dataset('bioasq', 'dream', split='test')\n",
    "    items = []\n",
    "    for row in ds:\n",
    "        question_text = row['question_text']\n",
    "        # BioASQ answers can be complex, often a list of strings or objects.\n",
    "        # We'll try to extract simple strings for 'correct_answers' and 'best_answer'.\n",
    "        # This might need refinement based on the exact structure of BioASQ answers.\n",
    "        correct_answers = []\n",
    "        best_answer = \"\"\n",
    "        if 'answers' in row and row['answers']:\n",
    "            # Assuming 'answers' is a list of strings or has a 'text' field\n",
    "            # For simplicity, taking the first answer text if available\n",
    "            if isinstance(row['answers'][0], str):\n",
    "                correct_answers = row['answers']\n",
    "                best_answer = row['answers'][0]\n",
    "            elif isinstance(row['answers'][0], dict) and 'text' in row['answers'][0]:\n",
    "                correct_answers = [ans['text'] for ans in row['answers'] if 'text' in ans]\n",
    "                if correct_answers: best_answer = correct_answers[0]\n",
    "\n",
    "        items.append({\n",
    "            'question': question_text,\n",
    "            'correct_answers': correct_answers,\n",
    "            'best_answer': best_answer,\n",
    "            'source': 'bioasq'\n",
    "        })\n",
    "        if max_samples and len(items) >= max_samples: break\n",
    "    return items\n",
    "\n",
    "print('Datasets ready')\n"
   ]
