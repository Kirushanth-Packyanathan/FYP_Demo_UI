    "#  CASCADE PIPELINE \u2014 full orchestrator\n",
    "from dataclasses import dataclass, asdict\n",
    "from typing import Optional, Dict, Any, List\n",
    "import torch\n",
    "import numpy as np\n",
    "import time\n",
    "\n",
    "def deep_verify(responses, contradiction_threshold=None):\n",
    "    \"\"\"\n",
    "    Performs pairwise NLI checks to find contradictions among responses.\n",
    "    \"\"\"\n",
    "    threshold = NLI_CONTRA_THRESH\n",
    "    n = len(responses)\n",
    "    if n <= 1: return {'is_hallucination': False, 'confidence': 0.0, 'contradiction_ratio': 0.0}\n",
    "\n",
    "    tokenizer = _nli_tok\n",
    "    model = _nli_model\n",
    "    device = next(model.parameters()).device\n",
    "\n",
    "    contradictions = 0\n",
    "    total_pairs = 0\n",
    "\n",
    "    for i in range(n):\n",
    "        for j in range(i + 1, n):\n",
    "            inputs = tokenizer(responses[i], responses[j], return_tensors='pt', truncation=True, max_length=512).to(device)\n",
    "            with torch.no_grad():\n",
    "                logits = model(**inputs).logits\n",
    "                probs = torch.softmax(logits, dim=-1).cpu().numpy()[0]\n",
    "\n",
    "            # DeBERTa MNLI: 0: contradiction, 1: neutral, 2: entailment\n",
    "            pred_label = probs.argmax()\n",
    "            if pred_label == 0:\n",
    "                contradictions += 1\n",
    "            total_pairs += 1\n",
    "\n",
    "    ratio = contradictions / total_pairs if total_pairs > 0 else 0\n",
    "    return {\n",
    "        'is_hallucination': ratio >= threshold,\n",
    "        'confidence': float(ratio),\n",
    "        'contradiction_ratio': float(ratio)\n",
    "    }\n",
    "\n",
    "@dataclass\n",
    "class CascadeResult:\n",
    "    query:str; model:str; responses:list; num_samples:int\n",
    "    num_clusters:int; cluster_sizes:dict; cluster_map:dict; dispersion:float\n",
    "    semantic_entropy:float; logit_confidence:float; fused_uncertainty:float\n",
    "    gate_decision:str; nli_result:Optional[dict]\n",
    "    is_hallucination:bool; hallucination_confidence:float\n",
    "    stage_timings:dict; total_time:float\n",
    "    def to_dict(self): return asdict(self)\n",
    "\n",
    "async def run_cascade(query, model=None, num_samples=None, temperature=None,\n",
    "                      skip_nli=False, params=None, on_sample=None, samples=None):\n",
    "    params = params or {}; model = model or HF_MODEL_NAME; timings = {}\n",
    "    t_start = time.perf_counter()\n",
    "\n",
    "    # Stage 0: Sampling\n",
    "    t0 = time.perf_counter()\n",
    "    if samples is None:\n",
    "        samples = await sample_responses(prompt=query, model=model,\n",
    "                    num_samples=num_samples, temperature=temperature, on_sample_received=on_sample)\n",
    "    timings['stage_0_sampling'] = time.perf_counter() - t0\n",
    "    texts = [s['response'] for s in samples if s['response']]\n",
    "    if not texts: raise ValueError('All generations empty')\n",
    "\n",
    "    # Stage 1: Clustering\n",
    "    t1 = time.perf_counter()\n",
    "    ci = cluster_responses(texts); disp = compute_dispersion(ci['embeddings'])\n",
    "    timings['stage_1_clustering'] = time.perf_counter() - t1\n",
    "\n",
    "    # Stage 2: Uncertainty\n",
    "    t2 = time.perf_counter()\n",
    "    sem_e = compute_weighted_semantic_entropy(ci['cluster_map'], samples)\n",
    "    conf = aggregate_confidence(samples)['mean']\n",
    "    # Updated to pass all 4 base features: H, D, C, K\n",
    "    fused = fuse_uncertainty(sem_e, disp, conf, float(ci['num_clusters']))\n",
    "    g = gate(fused)\n",
    "    timings['stage_2_uncertainty'] = time.perf_counter() - t2\n",
    "\n",
    "    # Stage 3: NLI / Verdict Logic\n",
    "    nli_res = None; is_hall = False; hall_conf = 0.0\n",
    "\n",
    "    if g == 'accept':\n",
    "        is_hall = False\n",
    "        hall_conf = fused\n",
    "    elif g == 'reject':\n",
    "        # FIXED: If the gate rejects, it is a hallucination by default due to high uncertainty\n",
    "        is_hall = True\n",
    "        if not skip_nli:\n",
    "            t3 = time.perf_counter()\n",
    "            nli_res = deep_verify(texts)\n",
    "            timings['stage_3_nli'] = time.perf_counter() - t3\n",
    "            # If NLI finds even stronger evidence, use it, otherwise keep 'reject' confidence\n",
    "            hall_conf = max(fused, nli_res['confidence'])\n",
    "        else:\n",
    "            hall_conf = fused\n",
    "    elif g == 'uncertain':\n",
    "        if not skip_nli:\n",
    "            t3 = time.perf_counter()\n",
    "            nli_res = deep_verify(texts)\n",
    "            timings['stage_3_nli'] = time.perf_counter() - t3\n",
    "            is_hall = nli_res['is_hallucination']\n",
    "            hall_conf = nli_res['confidence']\n",
    "        else:\n",
    "            # If uncertain and no NLI, flip a coin or use mid-range score\n",
    "            is_hall = fused > 0.5\n",
    "            hall_conf = fused\n",
    "\n",
    "    total = time.perf_counter() - t_start; timings['total'] = total\n",
    "    return CascadeResult(query=query, model=model, responses=texts, num_samples=len(texts),\n",
    "        num_clusters=ci['num_clusters'], cluster_sizes={str(k):v for k,v in ci['cluster_sizes'].items()},\n",
    "        cluster_map={str(k):v for k,v in ci['cluster_map'].items()}, dispersion=round(disp,4),\n",
    "        semantic_entropy=round(sem_e,4), logit_confidence=round(conf,4),\n",
    "        fused_uncertainty=round(fused,4), gate_decision=g, nli_result=nli_res,\n",
    "        is_hallucination=is_hall, hallucination_confidence=round(hall_conf,4),\n",
    "        stage_timings={k:round(v,4) for k,v in timings.items()}, total_time=round(total,4))\n",
    "\n",
    "print('Cascade pipeline updated with fixed Gating-NLI logic')"
   ]
  },
