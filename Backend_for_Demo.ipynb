    "# Cell 4: Correlation Analysis\n",
    "from statsmodels.stats.outliers_influence import variance_inflation_factor\n",
    "\n",
    "base_features = ['H', 'D', 'C', 'K']\n",
    "\n",
    "# 4a \u2014 Pearson correlation matrix (base features + target)\n",
    "corr_matrix = df[base_features + ['y']].corr()\n",
    "\n",
    "plt.figure(figsize=(7, 6))\n",
    "sns.heatmap(\n",
    "    corr_matrix, annot=True, fmt='.3f', cmap='RdBu_r',\n",
    "    center=0, vmin=-1, vmax=1, square=True,\n",
    "    linewidths=0.5, linecolor='white',\n",
    "    cbar_kws={'label': 'Pearson r'}\n",
    ")\n",
    "plt.title('Feature Correlation Matrix (incl. Target y)')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 4b \u2014 Point-biserial correlation with target\n",
    "print(\"\\n Correlation with Target (y) \")\n",
    "for feat in base_features:\n",
    "    r = df[feat].corr(df['y'])\n",
    "    print(f\"  {feat} , y : {r:+.4f}\")\n",
    "\n",
    "# 4c \u2014 Variance Inflation Factor (multicollinearity)\n",
    "X_vif = df[base_features].copy()\n",
    "X_vif.insert(0, 'const', 1)      # intercept term\n",
    "\n",
    "print(\"\\n Variance Inflation Factor (VIF) \")\n",
    "for i, col in enumerate(X_vif.columns):\n",
    "    if col == 'const':\n",
    "        continue\n",
    "    vif = variance_inflation_factor(X_vif.values, i)\n",
    "    flag = '  HIGH' if vif > 5 else ''\n",
    "    print(f\"  {col:>4s} : {vif:.2f}{flag}\")\n",
    "\n",
    "print(\"\\nRule of thumb: VIF > 5 \u2192 concerning, VIF > 10 \u2192 severe multicollinearity.\")\n"
   ]
