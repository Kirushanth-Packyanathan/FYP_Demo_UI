   "source": [
    "import torch\n",
    "from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\n",
    "\n",
    "print(f\"Loading {HF_MODEL_NAME} with 4-bit...\")\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(HF_MODEL_NAME, token=HF_TOKEN)\n",
    "if tokenizer.pad_token is None:\n",
    "    tokenizer.pad_token = tokenizer.eos_token\n",
    "\n",
    "# Strong 4-bit config for T4\n",
    "bnb_config = BitsAndBytesConfig(\n",
    "    load_in_4bit=True,\n",
    "    bnb_4bit_quant_type=\"nf4\",\n",
    "    bnb_4bit_compute_dtype=torch.float16,\n",
    "    bnb_4bit_use_double_quant=True,   # extra VRAM saving + slight speed\n",
    ")\n",
    "\n",
    "model = AutoModelForCausalLM.from_pretrained(\n",
    "    HF_MODEL_NAME,\n",
    "    quantization_config=bnb_config,\n",
    "    device_map=\"auto\",          # This should put it on GPU\n",
    "    torch_dtype=torch.float16,\n",
    "    token=HF_TOKEN,\n",
    "    low_cpu_mem_usage=True,\n",
    ")\n",
    "\n",
    "print(f\"Model loaded successfully on: {next(model.parameters()).device}\")\n",
    "print(f\"GPU Memory used: {torch.cuda.memory_allocated() / 1e9:.2f} GB\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "uGbbTHpNnOhs"
   },
   "source": [
    "## Full Pipeline \u2014 All Logic Inline\n",
    "\n",
    "The entire Multi-Signal Cascade + Semantic Entropy pipeline is defined below.  "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {
    "id": "5pgRhDiUhW-G"
   },
   "outputs": [],
   "source": [
    "async def sample_responses(prompt, model=None, num_samples=None, temperature=None, max_tokens=None, on_sample_received=None):\n",
    "    # Use the globally loaded model if none provided\n",
    "    if model is None:\n",
    "        model = globals().get('model')\n",
    "\n",
    "    if model is None:\n",
    "        raise RuntimeError(\"Model not found. Make sure 'llm' or 'model' is loaded in the global scope.\")\n",
    "\n",
    "    n = NUM_SAMPLES if num_samples is None else num_samples\n",
    "    tmp = TEMPERATURE if temperature is None else temperature\n",
    "    mx = MAX_TOKENS if max_tokens is None else max_tokens\n",
    "\n",
    "    # Apply brief prompting constraint to mimic original Semantic Entropy paper\n",
    "    brief_instruction = \"Answer the following question as briefly as possible in a single sentence or phrase.\\n\"\n",
    "    constrained_prompt = f\"{brief_instruction}Question: {prompt}\"\n",
    "\n",
    "    # Format prompt\n",
    "    if hasattr(tokenizer, 'chat_template') and tokenizer.chat_template:\n",
    "        try:\n",
    "            formatted = tokenizer.apply_chat_template(\n",
    "                [{'role': 'user', 'content': constrained_prompt}],\n",
    "                tokenize=False,\n",
    "                add_generation_prompt=True\n",
    "            )\n",
    "        except:\n",
    "            formatted = f\"{constrained_prompt}\\nAnswer:\"\n",
    "    else:\n",
    "        formatted = f\"{constrained_prompt}\\nAnswer:\"\n",
    "\n",
    "    inputs = tokenizer(formatted, return_tensors=\"pt\", truncation=True, max_length=1024)\n",
    "    inputs = {k: v.to(\"cuda\") for k, v in inputs.items()}\n",
    "\n",
    "    # Define stop criteria to prevent runaway generation\n",
    "    stop_strings = [\"Question:\", \"\\n\", tokenizer.eos_token]\n",
    "\n",
    "    # Heavy batched generation\n",
    "    with torch.no_grad():\n",
    "        outputs = model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=mx,\n",
    "            temperature=max(tmp, 0.01),\n",
    "            do_sample=True,\n",
    "            top_p=0.92,\n",
    "            top_k=60,\n",
    "            num_return_sequences=n,\n",
    "            output_scores=True,\n",
    "            return_dict_in_generate=True,\n",
    "            pad_token_id=tokenizer.pad_token_id,\n",
    "            eos_token_id=tokenizer.eos_token_id,\n",
    "        )\n",
    "\n",
    "    generated_tokens = outputs.sequences[:, inputs[\"input_ids\"].shape[1]:]\n",
    "    texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)\n",
    "\n",
    "    # Post-process to clip text if the model started generating a new question or repetitive newlines\n",
    "    cleaned_texts = []\n",
    "    for text in texts:\n",
    "        for stop in [\"Question:\", \"\\n\"]:\n",
    "            if stop in text:\n",
    "                text = text.split(stop)[0]\n",
    "        cleaned_texts.append(text.strip())\n",
    "\n",
    "    # Extract logprobs\n",
    "    all_logprobs = []\n",
    "    for i in range(n):\n",
    "        sample_logprobs = []\n",
    "        for step, score in enumerate(outputs.scores):\n",
    "            if step < len(generated_tokens[i]):\n",
    "                token_id = generated_tokens[i][step].item()\n",
    "                if token_id != tokenizer.pad_token_id:\n",
    "                    lp = torch.log_softmax(score[i], dim=-1)\n",
    "                    sample_logprobs.append(float(lp[token_id].cpu()))\n",
    "        all_logprobs.append(sample_logprobs)\n",
    "\n",
    "    results = []\n",
    "    for i, text in enumerate(cleaned_texts):\n",
    "        results.append({\n",
    "            \"response\": text,\n",
    "            \"logprobs\": all_logprobs[i],\n",
    "            \"model\": HF_MODEL_NAME\n",
    "        })\n",
    "        if on_sample_received:\n",
    "            if asyncio.iscoroutinefunction(on_sample_received):\n",
    "                await on_sample_received(text)\n",
    "            else:\n",
    "                on_sample_received(text)\n",
    "\n",
    "    return results"
   ]
  },
