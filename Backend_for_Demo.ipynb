    "from sklearn.metrics import roc_curve\n",
    "import numpy as np\n",
    "\n",
    "# Re-create 'y' and 'y_prob' from the global df and trained model/scaler\n",
    "# The df contains the full dataset used for training, including labels.\n",
    "# The _fuser_model and _fuser_scaler are globally available from the previous cell.\n",
    "\n",
    "# Ensure feature_cols is defined for selecting features from df\n",
    "if 'feature_cols' not in globals():\n",
    "    feature_cols = ['H', 'D', 'C', 'K'] # Assuming these were the features used\n",
    "\n",
    "y = df['y'].values\n",
    "X_scaled = _fuser_scaler.transform(df[feature_cols].values)\n",
    "y_prob = _fuser_model.predict_proba(X_scaled)[:, 1]\n",
    "\n",
    "fpr, tpr, thresholds = roc_curve(y, y_prob)\n",
    "\n",
    "# Find the optimal threshold using Youden's J statistic\n",
    "optimal_idx = np.argmax(tpr - fpr)\n",
    "TAU_OPT = thresholds[optimal_idx]\n",
    "\n",
    "# Set TAU_LOW and TAU_HIGH based on the optimal threshold\n",
    "TAU_LOW = TAU_OPT * 0.7\n",
    "TAU_HIGH = TAU_OPT * 1.3\n",
    "\n",
    "print(f\"Re-calibrated TAU_OPT: {TAU_OPT:.4f}\")\n",
    "print(f\"New TAU_LOW: {TAU_LOW:.4f}\")\n",
    "print(f\"New TAU_HIGH: {TAU_HIGH:.4f}\")"
   ],
