    "#  UNCERTAINTY FUSION + GATING (fuser trained inline)\n",
    "_fuser_model = None; _fuser_scaler = None\n",
    "\n",
    "def fuse_uncertainty(H, D, C, K):\n",
    "    global _fuser_model, _fuser_scaler\n",
    "    if _fuser_model is not None and _fuser_scaler is not None:\n",
    "        # Corrected to pass all 4 base features (H, D, C, K)\n",
    "        X = np.array([[H, D, C, K]])\n",
    "        return float(_fuser_model.predict_proba(_fuser_scaler.transform(X))[0,1])\n",
    "\n",
    "def gate(score):\n",
    "    if score < TAU_LOW: return 'accept'\n",
    "    elif score > TAU_HIGH: return 'reject'\n",
    "    return 'uncertain'\n",
    "\n",
    "print('Uncertainty fusion ready')"
   ],
