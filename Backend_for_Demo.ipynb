   "source": [
    "import asyncio\n",
    "\n",
    "async def run_cascade_parallel(\n",
    "    generated_data,\n",
    "    progress_callback=None,\n",
    "    cascade_results_ref=None,\n",
    "    start_from=0,\n",
    "    max_concurrency=5\n",
    "):\n",
    "    cascade_results = cascade_results_ref if cascade_results_ref is not None else []\n",
    "    semaphore = asyncio.Semaphore(max_concurrency)\n",
    "\n",
    "    total = len(generated_data)\n",
    "\n",
    "    async def process_item(i, item):\n",
    "        async with semaphore:\n",
    "            question = item[\"question\"]\n",
    "            samples = item[\"responses\"]\n",
    "\n",
    "            if progress_callback:\n",
    "                progress_callback(i, total, 'question_start', question)\n",
    "\n",
    "            try:\n",
    "                result = await run_cascade(\n",
    "                    query=question,\n",
    "                    samples=samples,\n",
    "                    skip_nli=False\n",
    "                )\n",
    "                return (i, result.to_dict())\n",
    "\n",
    "            except Exception as e:\n",
    "                print(f\"Cascade error at index {i}: {e}\")\n",
    "                return (i, None)\n",
    "\n",
    "    tasks = [\n",
    "        process_item(i, generated_data[i])\n",
    "        for i in range(start_from, total)\n",
    "    ]\n",
    "\n",
    "    results = await asyncio.gather(*tasks)\n",
    "\n",
    "    # Maintain order\n",
    "    results.sort(key=lambda x: x[0])\n",
    "\n",
    "    for _, res in results:\n",
    "        if res is not None:\n",
    "            cascade_results.append(res)\n",
    "\n",
    "    return cascade_results\n"
   ]
