    "# CORRECTNESS CHECKS\n",
    "# Two separate functions \u2014 one per evaluation approach, matching each paper's protocol.\n",
    "import re, string\n",
    "import numpy as np\n",
    "from sklearn.metrics.pairwise import cosine_similarity as cos_sim\n",
    "\n",
    "def semantic_correctness_check(generated_responses, correct_answers,\n",
    "                               threshold=SIMILARITY_THRESHOLD):\n",
    "    \"\"\"Embedding-based correctness using majority vote across generated samples.\"\"\"\n",
    "\n",
    "    if not correct_answers or not generated_responses:\n",
    "        return False\n",
    "\n",
    "    # Encode reference answers once\n",
    "    c_embs = _encoder.encode(\n",
    "        correct_answers,\n",
    "        normalize_embeddings=True\n",
    "    )\n",
    "\n",
    "    votes = 0\n",
    "\n",
    "    for resp in generated_responses:\n",
    "\n",
    "        matched = False\n",
    "\n",
    "        # Fast exact/substring match\n",
    "        resp_lower = resp.lower()\n",
    "        for ans in correct_answers:\n",
    "            if ans.lower() in resp_lower:\n",
    "                matched = True\n",
    "                break\n",
    "\n",
    "        # Otherwise use semantic similarity\n",
    "        if not matched:\n",
    "            r_emb = _encoder.encode(\n",
    "                [resp[:512]],\n",
    "                normalize_embeddings=True\n",
    "            )\n",
    "\n",
    "            matched = (\n",
    "                float(np.max(cos_sim(r_emb, c_embs))) >= threshold\n",
    "            )\n",
    "\n",
    "        if matched:\n",
    "            votes += 1\n",
    "\n",
    "    # Majority vote across all generated responses\n",
    "    return votes > len(generated_responses) / 2\n",
    "\n",
    "\n",
    "# 2. SEMANTIC ENTROPY BASELINE \u2014 Normalised Exact Match\n",
    "#    Faithfully replicates Kuhn et al. (2022/2023) evaluation protocol, which\n",
    "#    mirrors the official TriviaQA / SQuAD evaluation scripts.\n",
    "#    Only the primary (first) generated response is evaluated.\n",
    "_ARTICLES_RE = re.compile(r'\\b(a|an|the)\\b', re.IGNORECASE)\n",
    "\n",
    "def _normalize_answer(text: str) -> str:\n",
    "    \"\"\"Lowercase, strip punctuation, articles, and extra whitespace.\"\"\"\n",
    "    text = text.lower()\n",
    "    text = ''.join(ch for ch in text if ch not in string.punctuation)\n",
    "    text = _ARTICLES_RE.sub(' ', text)\n",
    "    text = ' '.join(text.split())\n",
    "    return text\n",
    "\n",
    "def se_correctness_check(generated_responses, correct_answers) -> bool:\n",
    "    \"\"\"\n",
    "    Normalised Exact Match \u2014 SE paper protocol (Kuhn et al. 2022).\n",
    "    Uses the PRIMARY (first) generated response only, matching the original paper.\n",
    "    \"\"\"\n",
    "    if not correct_answers or not generated_responses:\n",
    "        return False\n",
    "    norm_pred = _normalize_answer(generated_responses[0])\n",
    "    return any(_normalize_answer(gt) == norm_pred for gt in correct_answers if gt)\n",
    "\n",
    "\n",
    "print(\"Correctness checks ready:\")\n",
    "print(\"  - semantic_correctness_check()  [MSCF \u2014 SBERT embedding similarity]\")\n",
    "print(\"  - se_correctness_check()        [SE Baseline \u2014 normalised exact match, Kuhn et al.]\")"
   ]
