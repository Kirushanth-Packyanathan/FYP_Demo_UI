   "source": [
    "# Stage 1: Generation + Save to Drive\n",
    "import json\n",
    "import os\n",
    "import asyncio\n",
    "\n",
    "# Check if file exists in Drive to load or initialize\n",
    "if os.path.exists(GEN_SAVE_PATH):\n",
    "    with open(GEN_SAVE_PATH, \"r\") as f:\n",
    "        all_outputs = json.load(f)\n",
    "    print(f\"Loaded {len(all_outputs)} existing samples from Drive.\")\n",
    "else:\n",
    "    all_outputs = []\n",
    "    print(\"No existing file found. Starting fresh generation.\")\n",
    "\n",
    "# Load the dataset based on the DATASET configuration\n",
    "loaders = {'truthfulqa': load_truthfulqa, 'triviaqa': load_triviaqa, 'squad': load_squad, 'bioasq': load_bioasq}\n",
    "loader = loaders.get(DATASET, load_truthfulqa)\n",
    "\n",
    "try:\n",
    "    full_dataset = loader(max_samples=MAX_QUESTIONS)\n",
    "except Exception as e:\n",
    "    print(f\"ERROR: Could not load dataset '{DATASET}'. Details: {e}\")\n",
    "    raise e\n",
    "\n",
    "# Determine where to start if resuming\n",
    "start_idx = len(all_outputs)\n",
    "\n",
    "if start_idx < MAX_QUESTIONS:\n",
    "    for idx in range(start_idx, len(full_dataset)):\n",
    "        item = full_dataset[idx]\n",
    "        q = item['question']\n",
    "        print(f\"[{idx+1}/{MAX_QUESTIONS}] Generating...\")\n",
    "\n",
    "        # Use the existing async sample_responses function\n",
    "        responses = await sample_responses(\n",
    "            prompt=q,\n",
    "            model=model,\n",
    "            num_samples=NUM_SAMPLES\n",
    "        )\n",
    "\n",
    "        # Verification check for logprobs (critical for Semantic Entropy)\n",
    "        if idx == start_idx:\n",
    "            has_logprobs = all(len(r.get('logprobs', [])) >= 0 for r in responses)\n",
    "            print(f\"--- Logprob check: {'PASS' if has_logprobs else 'FAIL'} ---\")\n",
    "\n",
    "        all_outputs.append({\n",
    "            \"question\": q,\n",
    "            \"responses\": responses\n",
    "        })\n",
    "\n",
    "        # periodic save\n",
    "        if (idx + 1) % 10 == 0:\n",
    "            with open(GEN_SAVE_PATH, \"w\") as f:\n",
    "                json.dump(all_outputs, f, indent=2)\n",
    "            print(f\"Checkpoint saved at {idx+1}\")\n",
    "\n",
    "    # final save\n",
    "    with open(GEN_SAVE_PATH, \"w\") as f:\n",
    "        json.dump(all_outputs, f, indent=2)\n",
    "    print(\"Generation complete and saved with logprobs.\")\n",
    "else:\n",
    "    print(\"Generation already complete based on existing file.\")"
   ]
  },
