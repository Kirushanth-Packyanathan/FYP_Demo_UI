    "import pandas as pd\n",
    "import numpy as np\n",
    "from IPython.display import display, HTML\n",
    "from sklearn.metrics import roc_curve, roc_auc_score\n",
    "\n",
    "# Extract Results\n",
    "cr_list = results.get('cascade_results', [])\n",
    "er_list = results.get('entropy_results', [])\n",
    "\n",
    "# Load Dataset\n",
    "loaders = {\n",
    "    'truthfulqa': load_truthfulqa,\n",
    "    'triviaqa': load_triviaqa,\n",
    "    'squad': load_squad\n",
    "}\n",
    "\n",
    "full_ds = loaders.get(DATASET, load_truthfulqa)(max_samples=MAX_QUESTIONS)\n",
    "q_to_answers = {\n",
    "    item['question']: item.get('correct_answers', [])\n",
    "    for item in full_ds\n",
    "}\n",
    "\n",
    "# COMMON GROUND TRUTH (USED FOR BOTH METHODS)\n",
    "# SBERT Semantic Similarity Majority Vote\n",
    "shared_ground_truths = []\n",
    "\n",
    "for r in cr_list:\n",
    "    q = r['query']\n",
    "    correct_answers = q_to_answers.get(q, [])\n",
    "\n",
    "    is_correct = semantic_correctness_check(\n",
    "        r['responses'],\n",
    "        correct_answers\n",
    "    )\n",
    "\n",
    "    # 0 = Correct\n",
    "    # 1 = Hallucination\n",
    "    gt = 0 if is_correct else 1\n",
    "    shared_ground_truths.append(gt)\n",
    "\n",
    "print(\n",
    "    f\"Shared Ground Truth \u2014 {len(shared_ground_truths)} samples | \"\n",
    "    f\"Hallucination rate: \"\n",
    "    f\"{sum(shared_ground_truths)/max(len(shared_ground_truths),1):.1%}\"\n",
    ")\n",
    "\n",
    "# MSCF RESULTS\n",
    "cascade_ground_truths = shared_ground_truths\n",
    "\n",
    "cascade_scores = []\n",
    "cascade_times = []\n",
    "cascade_predictions = []\n",
    "\n",
    "for r in cr_list:\n",
    "    cascade_scores.append(r['fused_uncertainty'])\n",
    "    cascade_times.append(r.get('total_time', 0))\n",
    "    cascade_predictions.append(r['is_hallucination'])\n",
    "\n",
    "print(\n",
    "    f\"MSCF \u2014 {len(cascade_scores)} samples\"\n",
    ")\n",
    "\n",
    "# SEMANTIC ENTROPY RESULTS\n",
    "entropy_ground_truths = shared_ground_truths\n",
    "\n",
    "entropy_scores = []\n",
    "entropy_times = []\n",
    "num_clusters_list = []\n",
    "\n",
    "for r in er_list:\n",
    "    entropy_scores.append(r['semantic_entropy'])\n",
    "    entropy_times.append(r.get('total_time', 0))\n",
    "    num_clusters_list.append(r.get('num_clusters', 0))\n",
    "\n",
    "print(\n",
    "    f\"Semantic Entropy \u2014 {len(entropy_scores)} samples\"\n",
    ")\n",
    "\n",
    "# MSCF METRICS\n",
    "cascade_metrics = evaluate_all(\n",
    "    cascade_ground_truths,\n",
    "    cascade_scores,\n",
    "    cascade_times\n",
    ")\n",
    "\n",
    "if len(set(cascade_ground_truths)) > 1:\n",
    "    cascade_metrics[\"auroc\"] = float(\n",
    "        roc_auc_score(\n",
    "            cascade_ground_truths,\n",
    "            cascade_scores\n",
    "        )\n",
    "    )\n",
    "\n",
    "if len(cascade_ground_truths) > 1:\n",
    "\n",
    "    fpr_c, tpr_c, thresh_c = roc_curve(\n",
    "        cascade_ground_truths,\n",
    "        cascade_scores\n",
    "    )\n",
    "\n",
    "    j_scores_c = tpr_c - fpr_c\n",
    "    optimal_thresh_c = thresh_c[np.argmax(j_scores_c)]\n",
    "\n",
    "    cascade_metrics[\"optimal_threshold\"] = float(optimal_thresh_c)\n",
    "\n",
    "    cascade_metrics[\"detection_accuracy\"] = float(\n",
    "        np.mean(\n",
    "            (np.array(cascade_scores) > optimal_thresh_c)\n",
    "            ==\n",
    "            np.array(cascade_ground_truths)\n",
    "        )\n",
    "    )\n",
    "\n",
    "# SEMANTIC ENTROPY METRICS\n",
    "entropy_metrics = evaluate_all(\n",
    "    entropy_ground_truths,\n",
    "    entropy_scores,\n",
    "    entropy_times\n",
    ")\n",
    "\n",
    "if len(set(entropy_ground_truths)) > 1:\n",
    "    entropy_metrics[\"auroc\"] = float(\n",
    "        roc_auc_score(\n",
    "            entropy_ground_truths,\n",
    "            entropy_scores\n",
    "        )\n",
    "    )\n",
    "\n",
    "if len(entropy_ground_truths) > 1:\n",
    "\n",
