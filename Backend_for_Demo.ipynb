    "scaler_filename  = os.path.join(CASCADE_MODEL_DIR, f\"scaler_{MODEL_SAFE_NAME}_{DATASET}.joblib\")\n",
    "accuracy_filename = os.path.join(CASCADE_MODEL_DIR, f\"fuser_accuracy_{MODEL_SAFE_NAME}_{DATASET}.json\")\n",
    "\n",
    "print(f\"Model dir : {CASCADE_MODEL_DIR}\")\n",
    "print(f\"Dataset   : {DATASET}\")\n"
